# Vite exposes client-side variables that start with VITE_.
VITE_API_BASE_URL=http://localhost:3000/api

# Optional: Firebase Auth (shared ADR 0003). Leave unset to run the app
# unauthenticated — apiClient sends requests without a Bearer token and
# AuthContext reports isConfigured: false.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Frontend half of the AUTH_DISABLED toggle (backend ADR 0016). Exactly 'true'
# forces the login-less path even when all VITE_FIREBASE_* values are set —
# mirrors the backend, where AUTH_DISABLED=true passes every request through.
# The prod deploy wires this from the same AUTH_DISABLED repo variable.
# VITE_AUTH_DISABLED=
